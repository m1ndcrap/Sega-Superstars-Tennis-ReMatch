+    const uint32_t address = data->GetInputBufferAddress(b);
+    const uint32_t packets =
+        b == 0 ? data->input_buffer_0_packet_count : data->input_buffer_1_packet_count;
+    if (address && packets) {
+      sizes[b] = packets * kBytesPerPacket;
+      bin.write(reinterpret_cast<const char*>(memory()->TranslatePhysical(address)), sizes[b]);
+    }
+  }
+  bin.close();
+
+  std::ofstream txt(stem + ".txt");
+  txt << fmt::format(
+      "context {}\ncontext bytes {}\nbuffer 0: address {:08X}, {} packets, valid {}, {} bytes in "
+      "the .bin\nbuffer 1: address {:08X}, {} packets, valid {}, {} bytes in the .bin\ncurrent "
+      "buffer {}\nread offset {} (packet {} bit {})\nframe bits {}\n{} ch, {} Hz\nloop count {}, "
+      "start {}, end {}, subframe end {}, subframe skip {}\nframes before it (buffer:offset+size, "
+      "ok / ? no output / ! ffmpeg complained):{}\n",
+      id(), sizeof(XMA_CONTEXT_DATA), data->GetInputBufferAddress(0),
+      static_cast<uint32_t>(data->input_buffer_0_packet_count),
+      static_cast<uint32_t>(data->input_buffer_0_valid), sizes[0], data->GetInputBufferAddress(1),
+      static_cast<uint32_t>(data->input_buffer_1_packet_count),
+      static_cast<uint32_t>(data->input_buffer_1_valid), sizes[1],
+      static_cast<uint32_t>(data->current_buffer),
+      static_cast<uint32_t>(data->input_buffer_read_offset), packet_index, bit, frame_bits,
+      data->is_stereo ? 2 : 1, GetSampleRate(data->sample_rate),
+      static_cast<uint32_t>(data->loop_count), static_cast<uint32_t>(data->loop_start),
+      static_cast<uint32_t>(data->loop_end), static_cast<uint32_t>(data->loop_subframe_end),
+      static_cast<uint32_t>(data->loop_subframe_skip), RecentFramesText());
+
+  REXAPU_WARN("XmaContext {}: bad frame - wrote {}.bin / .txt ({})", id(),
+              std::filesystem::absolute(stem, ec).string(),
+              "the input buffers and context, for replaying offline");
