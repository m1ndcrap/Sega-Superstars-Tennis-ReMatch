--- a/src/audio/xma_decoder.cpp
+++ b/src/audio/xma_decoder.cpp
@@ -59,7 +59,15 @@ XmaDecoder::XmaDecoder(runtime::FunctionDispatcher* function_dispatcher)
 
 XmaDecoder::~XmaDecoder() = default;
 
+// sst_rematch: ffmpeg warnings / errors on this thread; XmaContext::Decode compares it around a
+// frame to tell a garbage frame from a good one
+thread_local uint32_t g_xma_ffmpeg_complaints = 0;
+
 void av_log_callback(void* avcl, int level, const char* fmt, va_list va) {
+  if (level <= AV_LOG_WARNING) {
+    ++g_xma_ffmpeg_complaints;
+  }
+
   if (!REXCVAR_GET(ffmpeg_verbose) && level > AV_LOG_WARNING) {
     return;
   }
