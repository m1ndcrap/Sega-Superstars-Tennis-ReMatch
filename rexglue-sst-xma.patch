+  if (limit <= 0 || dumps.load() >= limit) {
+    return;
+  }
+  const int32_t n = dumps.fetch_add(1);
+  if (n >= limit) {
+    return;
+  }
+
+  std::error_code ec;
+  std::filesystem::create_directories("xma_dump", ec);
+  const std::string stem = fmt::format("xma_dump/ctx{}_{}", id(), n);
+
+  std::ofstream bin(stem + ".bin", std::ios::binary);
+  if (!bin) {
+    REXAPU_WARN("XmaContext {}: could not write {}.bin", id(), stem);
+    return;
+  }
+
+  // Layout: the guest's context (sizeof(XMA_CONTEXT_DATA), big-endian as in memory), then input
+  // buffer 0 and input buffer 1 (packet count x 2048 bytes each, as in memory)
+  const auto* guest_context = memory()->TranslateVirtual(guest_ptr());
+  bin.write(reinterpret_cast<const char*>(guest_context), sizeof(XMA_CONTEXT_DATA));
